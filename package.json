{
	"name": "@activatus/code-standards",
	"version": "3.0.1",
	"description": "The Activatus code standards: the rules as Markdown, and the config files to copy. Install it so an AI agent can read the standards from node_modules.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/activatus-life/code-standards.git"
	},
	"homepage": "https://activatus-code-standards.vercel.app",
	"files": [
		"docs",
		"scripts",
		"static/templates",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"docusaurus": "docusaurus",
		"start": "docusaurus start",
		"build": "docusaurus build",
		"serve": "docusaurus serve",
		"clear": "docusaurus clear",
		"typecheck": "tsc",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@docusaurus/core": "3.10.2",
		"@docusaurus/module-type-aliases": "3.10.2",
		"@docusaurus/preset-classic": "3.10.2",
		"@docusaurus/theme-mermaid": "3.10.2",
		"@docusaurus/tsconfig": "3.10.2",
		"@docusaurus/types": "3.10.2",
		"@getcanary/docusaurus-theme-search-pagefind": "1.0.2",
		"@getcanary/web": "^1.0.0",
		"@mdx-js/react": "^3.0.0",
		"clsx": "^2.0.0",
		"pagefind": "^1.3.0",
		"prettier": "^3.9.10",
		"prism-react-renderer": "^2.3.0",
		"raw-loader": "^4.0.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"typescript": "~5.6.2"
	},
	"browserslist": {
		"production": [
			">0.5%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 3 chrome version",
			"last 3 firefox version",
			"last 5 safari version"
		]
	},
	"engines": {
		"node": ">=20.0"
	}
}
