{
	"name": "@activatus/code-standards",
	"version": "3.2.2",
	"description": "The Activatus code standards: the rules as Markdown, and the config files to copy. Install it so an AI agent can read the standards from node_modules.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/activatus-life/code-standards.git"
	},
	"homepage": "https://activatus-code-standards.vercel.app",
	"files": [
		"docs",
		"scripts/renameSymbol.mjs",
		"scripts/verifyStandards/*.mjs",
		"!scripts/verifyStandards/*.test.mjs",
		"!scripts/verifyStandards/testProject.mjs",
		"static/templates",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"docusaurus": "docusaurus",
		"start": "docusaurus start",
		"build": "docusaurus build",
		"serve": "docusaurus serve",
		"clear": "docusaurus clear",
		"typecheck": "tsc",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check:eslint-templates": "node scripts/checkEslintTemplates.mjs",
		"test": "node --test \"scripts/verifyStandards/*.test.mjs\""
	},
	"devDependencies": {
		"@docusaurus/core": "3.10.2",
		"@docusaurus/mdx-loader": "3.10.2",
		"@docusaurus/module-type-aliases": "3.10.2",
		"@docusaurus/preset-classic": "3.10.2",
		"@docusaurus/theme-mermaid": "3.10.2",
		"@docusaurus/tsconfig": "3.10.2",
		"@docusaurus/types": "3.10.2",
		"@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
		"@eslint/js": "^10.0.1",
		"@getcanary/docusaurus-theme-search-pagefind": "1.0.2",
		"@getcanary/web": "^1.0.0",
		"@mdx-js/react": "^3.0.0",
		"clsx": "^2.0.0",
		"eslint": "^10.13.0",
		"eslint-config-next": "^16.4.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-unicorn": "^78.0.0",
		"globals": "^17.13.0",
		"next": "^16.4.2",
		"pagefind": "^1.3.0",
		"prettier": "^3.9.10",
		"prism-react-renderer": "^2.3.0",
		"raw-loader": "^4.0.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"typescript": "~5.6.2",
		"typescript-eslint": "^8.71.2"
	},
	"browserslist": {
		"production": [
			">0.5%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 3 chrome version",
			"last 3 firefox version",
			"last 5 safari version"
		]
	},
	"engines": {
		"node": ">=20.0"
	}
}
